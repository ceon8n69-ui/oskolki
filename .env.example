# Пример окружения. Секреты задаются в Railway → Variables, не в репозитории.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgres://user:password@host:5432/oskolki
# HTTPS-адрес, на котором доступна Mini App (кнопка бота и ссылки ведут сюда)
PUBLIC_URL=https://oskolki.up.railway.app
# Токен бота @oskolki_k_bot от BotFather — нужен для проверки initData и уведомлений
BOT_TOKEN=
BOT_USERNAME=oskolki_k_bot
# off | polling | webhook  (на Railway рекомендован webhook)
BOT_MODE=webhook
WEBHOOK_SECRET=длинная-случайная-строка
# ≥32 символов, подпись сессий
SESSION_SECRET=
# Доступ к /api/admin/* (заголовок x-admin-token)
ADMIN_TOKEN=
# Тестовый вход без Telegram. Только локально; в production сервер не запустится с DEV_AUTH=1
# DEV_AUTH=1
